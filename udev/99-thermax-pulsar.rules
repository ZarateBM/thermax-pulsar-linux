# Udev rule for THERMAX 6 PULSAR CPU Cooler Display (XYZ-WC-AQUA)
# Vendor ID: 0x5131, Product ID: 0x2007

KERNEL=="hidraw*", ATTRS{idVendor}=="5131", ATTRS{idProduct}=="2007", MODE="0666", TAG+="uaccess"
SUBSYSTEM=="usb", ATTRS{idVendor}=="5131", ATTRS{idProduct}=="2007", MODE="0666", TAG+="uaccess"
